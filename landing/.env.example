# Copy this file to `.env.local` and fill in the values.

# Web3Forms access key that delivers "Book a demo" submissions to info@enviguide.com.
# Get a free key at https://web3forms.com (enter the recipient email, no signup required).
VITE_WEB3FORMS_ACCESS_KEY=your-web3forms-access-key

# Platform Sign In URL (Log in button). Defaults to same-origin /login if unset.
VITE_APP_LOGIN_URL=/login
